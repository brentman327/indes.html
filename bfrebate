<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appliance Rebate & Promo Directory</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Alpine.js for live search and interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-p-6">

    <div class="max-w-7xl mx-auto px-4 py-8" x-data="rebateApp()">
        <!-- Header -->
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Appliance Rebate Matrix & Terms</h1>
            <p class="text-sm text-slate-500 mt-2">Analyzed promotional data sorted by brand, featuring search, terms, and stackability info.</p>
        </header>

        <!-- Search Bar -->
        <div class="mb-8 max-w-xl mx-auto">
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    🔍
                </span>
                <input 
                    type="text" 
                    x-model="search" 
                    placeholder="Search by brand name, date, keyword, or terms..." 
                    class="w-full pl-10 pr-4 py-3 bg-white border border-slate-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
                >
            </div>
        </div>

        <!-- Rebate Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <template x-for="item in filteredRebates" :key="item.id">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
                    <div>
                        <!-- Top Row: Brand & Stackable Badge -->
                        <div class="flex justify-between items-start gap-2 mb-3">
                            <h2 class="text-xl font-bold text-slate-900" x-text="item.brand"></h2>
                            <span 
                                class="px-2.5 py-1 text-xs font-semibold rounded-full"
                                :class="item.stackable ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'"
                                x-text="item.stackable ? 'Stackable' : 'Standard / Check Terms'"
                            ></span>
                        </div>

                        <!-- Promo Title / Event -->
                        <p class="text-sm font-medium text-blue-600 mb-2" x-text="item.title"></p>

                        <!-- Dates -->
                        <p class="text-xs text-slate-500 mb-4 flex items-center gap-1">
                            <span>📅</span> <span x-text="item.dates"></span>
                        </p>

                        <!-- Reward Tiers -->
                        <div class="bg-slate-50 rounded-lg p-3 mb-4 border border-slate-100">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Rebate Structure</span>
                            <div class="text-xs space-y-1">
                                <template x-for="tier in item.tiers">
                                    <div class="flex justify-between py-1 border-b border-slate-200/60 last:border-0">
                                      <span class="text-slate-600" x-text="tier.qty"></span>
                                      
